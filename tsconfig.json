{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./client/src/*"
      ]
    },
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "client/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}

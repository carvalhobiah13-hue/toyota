    "react": "19.2.1",
    "react-dom": "19.2.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.3.1",
    "wouter": "3.7.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.14",
    "@types/node": "24.7.0",
    "@types/react": "19.2.1",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "5.0.4",
    "tailwindcss": "4.1.14",
